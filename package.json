{
  "type": "module",
  "volta": {
    "node": "24.19.0"
  },
  "scripts": {
    "fmt": "prettier --write .",
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package-extensions": "node src/package-extensions.js",
    "sort-extensions": "node src/sort-extensions.js",
    "danger": "danger",
    "check:registry": "node scripts/check-registry.mjs",
    "check:tooling": "pnpm run build && pnpm run test && pnpm run test:commit-message",
    "commit": "commitprompt",
    "test:commit-message": "node --test scripts/commit-message.node-test.mjs",
    "check": "pnpm run check:tooling && pnpm run check:registry && node --test scripts/ci-scope.node-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@iarna/toml": "2.2.5",
    "git-submodule-js": "1.0.5",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@santi020k/commitprompt": "1.1.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "danger": "13.0.8",
    "danger-plugin-pr-hygiene": "0.7.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
